# Analytics providers are independently optional. Add the matching value to your
# local .env.local file and to your production hosting environment to enable one.

# Google Analytics 4 web data stream measurement ID (for example: G-ABC1234567)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PostHog project token and regional ingestion host. In PostHog, enable
# Project Settings > Web analytics > Cookieless server hash mode.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Web Analytics site token from the site's JS snippet. Leave this
# empty when Cloudflare already injects Web Analytics automatically for the zone.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
